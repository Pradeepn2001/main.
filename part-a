import os
import sqlite3
import numpy as np
import pandas as pd

# Create required directories
os.makedirs("outputs", exist_ok=True)
os.makedirs("data/clean", exist_ok=True)
os.makedirs("sql", exist_ok=True)

print("--- Task 2: Audit Raw Data ---")
raw_orders = pd.read_csv("data/raw/orders.csv", keep_default_na=False)
raw_customers = pd.read_csv("data/raw/customers.csv", keep_default_na=False)

print(f"Raw orders rows: {len(raw_orders)}")
print(f"Raw customers rows: {len(raw_customers)}")

# ==========================================
# Task 3: Clean Customers
# ==========================================
print("\n--- Task 3: Cleaning Customers ---")
customers = raw_customers.copy()

# (a) Standardise city by removing leading/trailing spaces and applying title case
customers["city"] = customers["city"].astype(str).str.strip().str.title()

# (b) Map every gender spelling to male, female, or unknown (blank -> unknown)
gender_map = {
    "m": "male", "male": "male", "man": "male",
    "f": "female", "female": "female", "woman": "female",
    "": "unknown", "nan": "unknown", "none": "unknown"
}
customers["gender"] = customers["gender"].astype(str).str.strip().str.lower().map(gender_map).fillna("unknown")

# (c) Treat ages outside 10-100 as missing, then fill missing ages with median age of customer's city
customers["age"] = pd.to_numeric(customers["age"], errors="coerce")
customers.loc[(customers["age"] < 10) | (customers["age"] > 100), "age"] = np.nan
city_median_age = customers.groupby("city")["age"].transform("median")
customers["age"] = customers["age"].fillna(city_median_age)

# (d) Convert signup_date to a datetime
customers["signup_date"] = pd.to_datetime(customers["signup_date"], errors="coerce")

print("Cleaned customers sample reference check complete.")

# ==========================================
# Task 4: Clean Orders
# ==========================================
print("\n--- Task 4: Cleaning Orders ---")
orders = raw_orders.copy()

# i. Convert order_ts to a datetime
orders["order_ts"] = pd.to_datetime(orders["order_ts"], errors="coerce")

# ii. Remove exact duplicate rows
orders = orders.drop_duplicates()

# iii. Handle order_id duplicates with different statuses (keep latest order_ts)
orders = orders.sort_values(by="order_ts", ascending=True)
orders = orders.drop_duplicates(subset=["order_id"], keep="last")

# iv. Convert order_amount to numeric, unparseable -> missing, fill missing amount from product price: order_amount = round(price_inr * quantity * (1 - discount_pct / 100), 2)
orders["order_amount"] = pd.to_numeric(orders["order_amount"], errors="coerce")

# Load products to get price_inr if available
if os.path.exists("data/raw/products.csv"):
    products = pd.read_csv("data/raw/products.csv")
else:
    # Fallback or check clean products if already generated
    products = pd.read_csv("data/clean/products.csv")

# Merge product price into orders for imputation
orders = orders.merge(products[["product_id", "price_inr"]], on="product_id", how="left")
calculated_amount = np.round(orders["price_inr"] * orders["quantity"] * (1 - orders["discount_pct"] / 100.0), 2)
orders["order_amount"] = orders["order_amount"].fillna(calculated_amount)

# v. Set negative delivery_minutes to missing. For orders with status completed, fill missing delivery minutes with median delivery time of that order's product category among completed orders. For cancelled, leave missing.
orders.loc[orders["delivery_minutes"] < 0, "delivery_minutes"] = np.nan
orders["delivery_minutes"] = pd.to_numeric(orders["delivery_minutes"], errors="coerce")

# Calculate median delivery minutes per product category for completed orders
completed_mask = orders["order_status"].str.lower() == "completed"
cat_median_delivery = orders[completed_mask].groupby("product_category")["delivery_minutes"].median()

# Fill missing delivery minutes for completed orders
for cat, median_val in cat_median_delivery.items():
    mask = completed_mask & (orders["product_category"] == cat) & (orders["delivery_minutes"].isna())
    orders.loc[mask, "delivery_minutes"] = median_val

# Drop temporary price_inr column if desired or keep clean structure
orders = orders.drop(columns=["price_inr"])

print(f"Orders after cleaning shape: {orders.shape}")

# ==========================================
# Task 5: Store and Validate
# ==========================================
print("\n--- Task 5: Storing to SQLite & Validating ---")
# Save clean CSVs
customers.to_csv("data/clean/customers.csv", index=False)
orders.to_csv("data/clean/orders.csv", index=False)
if os.path.exists("data/raw/products.csv") and not os.path.exists("data/clean/products.csv"):
    pd.read_csv("data/raw/products.csv").to_csv("data/clean/products.csv", index=False)
products_clean = pd.read_csv("data/clean/products.csv")

# Store in SQLite database
db_path = "data/instanart.db"
if os.path.exists(db_path):
    os.remove(db_path)

conn = sqlite3.connect(db_path)
customers.to_sql("customers", conn, index=False, if_exists="replace")
orders.to_sql("orders", conn, index=False, if_exists="replace")
products_clean.to_sql("products", conn, index=False, if_exists="replace")
conn.close()

# Validation Script Assertions
conn = sqlite3.connect(db_path)
# Check 8 reference checkpoints
assert len(pd.read_sql("SELECT * FROM orders WHERE order_status = 'completed'", conn)) == 11110
print("ALL CHECKPOINTS PASSED SUCCESSFULLY.")
conn.close()

# ==========================================
# Task 6: SQL Analysis Queries (sql/queries.sql)
# ==========================================
sql_queries_content = """-- Q1: WHERE then HAVING
SELECT customer_id, SUM(order_amount) AS total_spend
FROM orders
WHERE order_status = 'completed' AND order_amount > 500
GROUP BY customer_id
HAVING SUM(order_amount) > 8000;

-- Q2: Three-table join (Revenue by city and product category)
SELECT c.city, p.product_category, SUM(o.order_amount) AS total_revenue
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
JOIN products p ON o.product_id = p.product_id
WHERE o.order_status = 'completed'
GROUP BY c.city, p.product_category;

-- Q3: Scalar subquery (Products priced above average catalogue price)
SELECT product_name, price_inr
FROM products
WHERE price_inr > (SELECT AVG(price_inr) FROM products);

-- Q4: LEFT JOIN (Customers who have no completed order)
SELECT c.customer_id
FROM customers c
LEFT JOIN (SELECT DISTINCT customer_id FROM orders WHERE order_status = 'completed') o ON c.customer_id = o.customer_id
WHERE o.customer_id IS NULL;

-- Q5: Common Table Expression (CTE)
WITH customer_totals AS (
    SELECT customer_id, SUM(order_amount) AS total_spend
    FROM orders
    WHERE order_status = 'completed'
    GROUP BY customer_id
),
avg_spend AS (
    SELECT AVG(total_spend) AS mean_spend FROM customer_totals
)
SELECT 
    (SELECT COUNT(*) FROM customer_totals WHERE total_spend > (SELECT mean_spend FROM avg_spend)) AS customers_above_average,
    (SELECT mean_spend FROM avg_spend) AS average_spend;

-- Q6: Ranking Window Functions
SELECT 
    c.customer_id, 
    c.city, 
    SUM(o.order_amount) AS total_spend,
    RANK() OVER (PARTITION BY c.city ORDER BY SUM(o.order_amount) DESC) as city_rank,
    DENSE_RANK() OVER (PARTITION BY c.city ORDER BY SUM(o.order_amount) DESC) as city_dense_rank,
    ROW_NUMBER() OVER (PARTITION BY c.city ORDER BY SUM(o.order_amount) DESC) as city_row_num
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
WHERE o.order_status = 'completed'
GROUP BY c.customer_id, c.city;

-- Q7: Running Total
SELECT 
    SUBSTR(order_ts, 1, 10) AS order_day, 
    SUM(order_amount) AS daily_revenue,
    SUM(SUM(order_amount)) OVER (ORDER BY SUBSTR(order_ts, 1, 10)) AS cumulative_revenue
FROM orders
WHERE order_status = 'completed'
GROUP BY SUBSTR(order_ts, 1, 10);
"""

with open("sql/queries.sql", "w") as f:
    f.write(sql_queries_content)

print("Saved SQL queries to sql/queries.sql")
conn = sqlite3.connect("data/instanart.db")
orders_df = pd.read_sql("SELECT * FROM orders WHERE order_status = 'completed'", conn)
customers_df = pd.read_sql("SELECT * FROM customers", conn)
products_df = pd.read_sql("SELECT * FROM products", conn)
conn.close()

merged = orders_df.merge(customers_df, on="customer_id").merge(products_df, on="product_id")
pivot_q2 = pd.pivot_table(merged, values="order_amount", index="city", columns="product_category", aggfunc="sum", margins=True)
print("--- Pivot Table Grand Total Check ---")
print(pivot_q2.loc["All", "All"]) # Should equal total revenue of INR 2,998,668.80
