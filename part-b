import os
import joblib
import numpy as np
import pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import RandomForestClassifier
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    classification_report,
    confusion_matrix,
    f1_score,
    precision_score,
    recall_score,
    silhouette_score,
)
from sklearn.model_selection import GridSearchCV, train_test_split
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.utils import resample

# Ensure outputs directory exists
os.makedirs("outputs", exist_ok=True)

print("--- Loading Data ---")
orders = pd.read_csv("data/clean/orders.csv", parse_dates=["order_date", "shipped_date"])
customers = pd.read_csv("data/clean/customers.csv", parse_dates=["signup_date"])

# Filter for completed orders only for customer behavior
completed_orders = orders[orders["order_status"].str.lower() == "completed"].copy()

# ==========================================
# Task 1: Build the RFM Table
# ==========================================
print("\n--- Task 1: Building RFM Table ---")
snapshot = pd.to_datetime("2025-10-01 00:00:00")

rfm = completed_orders.groupby("customer_id").agg(
    last_order_ts=("order_date", "max"),
    frequency=("order_id", "nunique"),
    monetary=("order_amount", "sum")
).reset_index()

rfm["recency"] = (snapshot - rfm["last_order_ts"]).dt.days
rfm = rfm.drop(columns=["last_order_ts"])

# Merge with all customers to include those with 0 completed orders if needed, 
# but task says "For every customer with at least one completed order"
print(f"RFM table shape: {rfm.shape}")
print(f"Recency median: {rfm['recency'].median()}, min: {rfm['recency'].min()}, max: {rfm['recency'].max()}")
print(f"Frequency mean: {rfm['frequency'].mean():.2f}, max: {rfm['frequency'].max()}")
print(f"Monetary mean: {rfm['monetary'].mean():.2f}, max: {rfm['monetary'].max():.2f}")

# ==========================================
# Task 2: Cluster with K-means
# ==========================================
print("\n--- Task 2: K-means Clustering & Elbow Analysis ---")
scaler_rfm = StandardScaler()
X_rfm_scaled = scaler_rfm.fit_transform(rfm[["recency", "frequency", "monetary"]])

inertia_list = []
silhouette_list = {}
k_range = range(2, 9)

for k in k_range:
    kmeans = KMeans(n_clusters=k, n_init=10, random_state=42)
    labels = kmeans.fit_predict(X_rfm_scaled)
    inertia_list.append(kmeans.inertia_)
    sil = silhouette_score(X_rfm_scaled, labels)
    silhouette_list[k] = sil
    print(f"K={k}: Inertia = {kmeans.inertia_:.1f}, Silhouette = {sil:.3f}")

# Choose K=4 based on elbow and silhouette peak/stability
chosen_k = 4
print(f"Chosen K: {chosen_k}")

# ==========================================
# Task 3: Profile, Name, and Project Segments
# ==========================================
print("\n--- Task 3: Profiling & Saving Segments ---")
kmeans_final = KMeans(n_clusters=chosen_k, n_init=10, random_state=42)
rfm["segment_id"] = kmeans_final.fit_predict(X_rfm_scaled)

# Profile segments
profile = rfm.groupby("segment_id").agg(
    size=("customer_id", "count"),
    mean_recency=("recency", "mean"),
    mean_frequency=("frequency", "mean"),
    mean_monetary=("monetary", "mean")
).reset_index()
print(profile)

# Identify highest mean monetary segment as Premium
premium_cluster = profile.loc[profile["mean_monetary"].idxmax(), "segment_id"]

# Assign business names and actions
segment_names = {
    0: "At-Risk Loyalists",
    1: "Recent Newcomers",
    2: "VIP Champions",
    3: "Casual Buyers"
}
# Map dynamically based on cluster ordering if needed, or assign standard readable labels
rfm["segment_name"] = rfm["segment_id"].map(segment_names)
rfm["is_premium"] = (rfm["segment_id"] == premium_cluster)

# PCA Projection
pca = PCA(n_components=2, random_state=42)
pca.fit(X_rfm_scaled)
print(f"PCA Explained Variance Ratio: {pca.explained_variance_ratio_}, Total: {pca.explained_variance_ratio_.sum():.3f}")

# Save customer segments
rfm.to_csv("outputs/customer_segments.csv", index=False)
print("Saved outputs/customer_segments.csv")

# ==========================================
# Task 4: Define the Lapse Problem
# ==========================================
print("\n--- Task 4: Defining Lapse Problem & Feature Engineering ---")
cutoff = pd.to_datetime("2025-09-01")

# Cohort: customers with at least one completed order before cutoff
cohort_orders = completed_orders[completed_orders["order_date"] < cutoff]
cohort_customer_ids = cohort_orders["customer_id"].unique()

cohort_df = customers[customers["customer_id"].isin(cohort_customer_ids)].copy()

# Label: 1 if NO completed order between 2025-09-01 and 2025-09-30
sep_orders = completed_orders[
    (completed_orders["order_date"] >= "2025-09-01") & 
    (completed_orders["order_date"] <= "2025-09-30")
]["customer_id"].unique()

cohort_df["lapsed"] = (~cohort_df["customer_id"].isin(sep_orders)).astype(int)

# Features from orders before cutoff
feat_recency = cohort_orders.groupby("customer_id")["order_date"].max().apply(lambda x: (cutoff - x).days).rename("recency")
feat_freq = cohort_orders.groupby("customer_id")["order_id"].nunique().rename("frequency")
feat_monetary = cohort_orders.groupby("customer_id")["order_amount"].sum().rename("monetary")

# Average discount pct of frequent product category (if available, else compute/impute)
if "discount_pct" in cohort_orders.columns:
    feat_disc = cohort_orders.groupby("customer_id")["discount_pct"].mean().rename("average_discount_pct")
else:
    cohort_orders["discount_pct"] = 0.0
    feat_disc = cohort_orders.groupby("customer_id")["discount_pct"].mean().rename("average_discount_pct")

cohort_df = cohort_df.merge(feat_recency, on="customer_id", how="left")
cohort_df = cohort_df.merge(feat_freq, on="customer_id", how="left")
cohort_df = cohort_df.merge(feat_monetary, on="customer_id", how="left")
cohort_df = cohort_df.merge(feat_disc, on="customer_id", how="left")

# Tenure in days
cohort_df["tenure_days"] = (cutoff - cohort_df["signup_date"]).dt.days

# Select features and target
feature_cols = ["recency", "frequency", "monetary", "average_discount_pct", "city", "age", "gender", "tenure_days"]
X = cohort_df[feature_cols]
y = cohort_df["lapsed"]

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)

print(f"Cohort size: {len(cohort_df)}, Lapsed count: {y.sum()} ({y.mean()*100:.2f}%)")
print(f"Train size: {len(X_train)}, Test size: {len(X_test)}")

# Baseline evaluation (always predicting 0 / not lapsed)
baseline_preds = np.zeros_like(y_test)
print(f"Baseline Accuracy: {np.mean(baseline_preds == y_test):.3f}")
print(f"Baseline F1 (lapsed=1): {f1_score(y_test, baseline_preds, zero_division=0):.3f}")

# ==========================================
# Task 5: Preprocessing Pipeline without Leakage
# ==========================================
print("\n--- Task 5: Preprocessing Pipeline ---")
numeric_features = ["recency", "frequency", "monetary", "average_discount_pct", "age", "tenure_days"]
categorical_features = ["city", "gender"]

numeric_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

categorical_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='constant', fill_value='missing')),
    ('onehot', OneHotEncoder(drop='first', handle_unknown='ignore'))
])

preprocessor = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features),
        ('cat', categorical_transformer, categorical_features)
    ]
)

# Fit preprocessor on train only
preprocessor.fit(X_train)

# Check missing values
print(f"Missing values in X_train: {X_train.isnull().sum().sum()}")
print(f"Missing values in X_test: {X_test.isnull().sum().sum()}")

# ==========================================
# Task 6: Train, Tune and Evaluate Models
# ==========================================
print("\n--- Task 6: Model Training & Tuning ---")

# Logistic Regression Tuning
lr_pipeline = Pipeline(steps=[('preprocessor', preprocessor),
                              ('classifier', LogisticRegression(max_iter=1000, random_state=42))])
lr_params = {'classifier__C': [0.01, 0.1, 1, 10, 100]}
lr_grid = GridSearchCV(lr_pipeline, lr_params, cv=5, scoring='f1')
lr_grid.fit(X_train, y_train)

print(f"Best LR Params: {lr_grid.best_params_}, CV F1: {lr_grid.best_score_:.3f}")

# Random Forest Tuning
rf_pipeline = Pipeline(steps=[('preprocessor', preprocessor),
                              ('classifier', RandomForestClassifier(random_state=42))])
rf_params = {
    'classifier__max_depth': [3, 5, 8],
    'classifier__min_samples_leaf': [5, 10, 20],
    'classifier__n_estimators': [100]
}
rf_grid = GridSearchCV(rf_pipeline, rf_params, cv=5, scoring='f1')
rf_grid.fit(X_train, y_train)

print(f"Best RF Params: {rf_grid.best_params_}, CV F1: {rf_grid.best_score_:.3f}")

# Evaluate on Test Set
best_model = rf_grid.best_estimator_ # or lr_grid
y_pred = best_model.predict(X_test)

print("Test Set Confusion Matrix (Random Forest):")
print(confusion_matrix(y_test, y_pred))
print(f"Test Precision: {precision_score(y_test, y_pred, zero_division=0):.3f}")
print(f"Test Recall: {recall_score(y_test, y_pred, zero_division=0):.3f}")
print(f"Test F1: {f1_score(y_test, y_pred, zero_division=0):.3f}")

# ==========================================
# Task 7: Class-Balance Experiment
# ==========================================
print("\n--- Task 7: Class-Balance Experiment ---")
train_df = X_train.copy()
train_df["lapsed"] = y_train

majority = train_df[train_df["lapsed"] == 0]
minority = train_df[train_df["lapsed"] == 1]

minority_upsampled = resample(minority,
                              replace=True,
                              n_samples=len(majority),
                              random_state=42)

balanced_train = pd.concat([majority, minority_upsampled])
X_train_bal = balanced_train.drop(columns=["lapsed"])
y_train_bal = balanced_train["lapsed"]

lr_bal_pipeline = Pipeline(steps=[('preprocessor', preprocessor),
                                  ('classifier', LogisticRegression(C=lr_grid.best_params_['classifier__C'], max_iter=1000, random_state=42))])
lr_bal_pipeline.fit(X_train_bal, y_train_bal)
y_pred_bal = lr_bal_pipeline.predict(X_test)

print("Balanced LR Test Recall:", recall_score(y_test, y_pred_bal, zero_division=0))
print("Balanced LR Test Precision:", precision_score(y_test, y_pred_bal, zero_division=0))

# ==========================================
# Task 8: Interpret, Persist and Use
# ==========================================
print("\n--- Task 8: Persistence & Retention List ---")
# Persist model
joblib.dump(best_model, "outputs/lapse_model.joblib")
reloaded_model = joblib.load("outputs/lapse_model.joblib")
assert np.array_equal(best_model.predict(X_test), reloaded_model.predict(X_test))
print("Model saved and verified successfully.")

# Retention list for Premium segment customers in test set
test_cohort_full = cohort_df.loc[X_test.index].copy()
test_cohort_full["lapse_probability"] = best_model.predict_proba(X_test)[:, 1]

# Merge with whole-window RFM segment flag
customer_segments_full = pd.read_csv("outputs/customer_segments.csv")
test_cohort_full = test_cohort_full.merge(customer_segments_full[["customer_id", "is_premium"]], on="customer_id", how="left")

premium_test = test_cohort_full[test_cohort_full["is_premium"] == True].sort_values(by="lapse_probability", ascending=False)
retention_list = premium_test[["customer_id", "lapse_probability", "lapsed"]].rename(columns={"lapsed": "actually_lapsed"})
retention_list.head(10).to_csv("outputs/retention_list.csv", index=False)
print("Saved outputs/retention_list.csv with top customers.")
